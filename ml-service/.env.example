# ICARE-CVD ML Service — environment variables
#
# Copy this file to `.env` (same folder) and fill in real values.
# `docker compose up` will pass these into every service that lists `env_file: .env`.

# ── Cloud LLM (Groq) ─────────────────────────────────────────────────────────
# Required by: ml-ecg, ml-echo, ml-medical, ml-ecg-rag
GROQ_API_KEY=

# ── Mistral OCR ──────────────────────────────────────────────────────────────
# Required by: ml-medical
MISTRAL_API_KEY=

# ── Optional overrides ───────────────────────────────────────────────────────
# Path inside the ml-main container to the coronary segmentation checkpoint.
# Leave empty to use the default baked into Dockerfile.main.
# MODEL_PATH=/service/app/CT/coronary_segmentation_model.pth

# Set to 1 to enable Flask debug mode in ml-medical (NOT recommended in prod).
FLASK_DEBUG=0

# ── ECG image classification (ml-ecg-classification :8503) ───────────────────
# Weights are bind-mounted from app/Ecg_Classification/best_maxvit_ecg_model 98.pth
# ECG_CLASSIFICATION_MODEL_PATH=/service/models/maxvit_ecg_98.pth
