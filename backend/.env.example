# PostgreSQL 18 via Docker (local: postgres:18). Compose overrides DATABASE_URL in the API container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/icare_cvd

JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=3000

# Optional: comma-separated origins for Next.js (e.g. http://localhost:3001)
# CORS_ORIGIN=
