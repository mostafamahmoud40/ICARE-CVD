# PostgreSQL 18 via Docker (local: postgres:18). Compose overrides DATABASE_URL in the API container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/icare_cvd

JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PORT=3000

# Optional: comma-separated origins for Next.js (e.g. http://localhost:3001)
# CORS_ORIGIN=

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# S3 storage (documents/images)
S3_REGION=eu-north-1
S3_BUCKET_NAME=icare-cvd-071604987125-eu-north-1-an
S3_ACCESS_KEY_ID=AKIARBK75MT2QLXU32NY
S3_SECRET_ACCESS_KEY=7bQGaavNcylPvApppYepZLGB57yWk8duBHbZYJhD
# Optional custom endpoint (e.g. MinIO / Cloudflare R2)
S3_ENDPOINT=
# Optional: set true for MinIO/localstack-style endpoints
S3_FORCE_PATH_STYLE=false
# Optional public URL base (e.g. https://cdn.example.com/bucket-name)
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=900
