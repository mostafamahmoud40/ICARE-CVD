# PostgreSQL 18 via Docker (local: postgres:18). Compose overrides DATABASE_URL in the API container.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/icare_cvd

JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET_HERE
JWT_ACCESS_TTL=30d
JWT_REFRESH_TTL=7d
PORT=3000

# Optional: comma-separated origins for Next.js (e.g. http://localhost:3001)
# CORS_ORIGIN=

# SMTP (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# S3 storage (documents/images)
S3_REGION=eu-north-1
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
# Optional custom endpoint (e.g. MinIO / Cloudflare R2)
S3_ENDPOINT=
# Optional: set true for MinIO/localstack-style endpoints
S3_FORCE_PATH_STYLE=false
# Optional public URL base (e.g. https://cdn.example.com/bucket-name)
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=900

# MinIO (chat attachments — separate from S3 documents above)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://127.0.0.1:9000
# When backend runs in Docker Compose, presigned URLs must use a host the browser can reach
MINIO_PRESIGN_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=icare-chat
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
MINIO_PUBLIC_BASE_URL=http://localhost:9000/icare-chat
MINIO_PRESIGN_TTL_SECONDS=3600

# Groq Inference API — patient chat, registration analysis, schedule AI (required for AI features)
# Care Agent uses LangChain (createAgent + ChatGroq + tool()) on top of Groq.
# Get API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_CHAT_FALLBACK_MODEL=
GROQ_ANALYSIS_MODEL=

# Chroma vector search — BGE-M3 (local TEI + GPU)
# Docker Compose: backend uses http://embeddings:80; browser/host uses http://localhost:8080
EMBEDDING_PROVIDER=bge-m3
# Docker Compose: backend uses http://embeddings:80; host/browser uses http://localhost:8090
BGE_M3_URL=http://localhost:8091
CHROMA_URL=http://localhost:8001

# TEI Docker image (GPU) — match your NVIDIA card:
#   cuda-1.9     — generic CUDA 12.2+ (try first)
#   86-1.9       — RTX 3060/3070/3080/3090, A10, A40 (Ampere 8.6)
#   89-1.9       — RTX 4060/4070/4080/4090 (Ada Lovelace)
#   turing-1.9   — GTX 1660, RTX 2060/2070/2080 (experimental)
#   hopper-1.9   — H100
# CPU fallback: ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# RTX 4060 / 4070 / 4080 / 4090 (Ada) — detected on this machine:
EMBEDDINGS_IMAGE=ghcr.io/huggingface/text-embeddings-inference:89-1.9

# Optional legacy: Cohere embeddings (384d) — only if you prefer cloud over BGE-M3
# EMBEDDING_PROVIDER=cohere
# COHERE_API_KEY=
# COHERE_EMBEDDING_MODEL=embed-multilingual-light-v3.0

# Web Push (browser notifications when app tab is closed)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@icare-cvd.local
